<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Početna - FER WEB2 Lab1</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>FER WEB2 Lab1</h1>
    <h2>Početna</h2>

    <p>Ukupan broj propusnica: <%= totalPasses %></p>
    <p>Broj aktivnih propusnica: <%= activePasses %></p>
    <% if (signedIn && user != null) { %>
        <a href="/logout">Odjava</a>
        <p>Pregled propusnica, poništavanje i brisanje pojedine propusnice</p>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ime</th>
                    <th>Dokument</th>
                    <th>Vrijeme izdavanja</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% passes.forEach(pass => { %>
                    <tr>
                        <td><a href="/pass/<%= pass.id %>" target="_blank"><%= pass.id %></a></td>
                        <td><%= pass.name %></td>
                        <td><%= pass.document %></td>
                        <td><%= pass.issued_at %></td>
                        <td><%= pass.status %></td>
                        <td>
                            <form action="/pass/<%= pass.id %>/cancel" method="post">
                                <button type="submit">Deactivate</button>
                            </form>
                        </td>
                        <td>
                            <form action="/pass/<%= pass.id %>/delete" method="post">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p>Niste prijavljeni!</p>
        <a href="/login">Prijava</a>
    <% } %>
      
</body>
</html>